{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/product.schema.json",
  "title": "Sauna product",
  "type": "object",
  "required": ["product_id", "brand", "model", "category", "status", "dimensions_cm", "people", "power", "sauna", "commercial", "editorial", "sources", "updated_at"],
  "properties": {
    "product_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "brand": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "category": { "enum": ["indoor", "outdoor", "infrared", "portable", "tent"] },
    "status": { "enum": ["draft", "verified", "archived"] },
    "dimensions_cm": {
      "type": "object",
      "required": ["width", "depth", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "people": {
      "type": "object",
      "required": ["min", "max", "seats", "lying_places"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "seats": { "type": "integer", "minimum": 0 },
        "lying_places": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "power": {
      "type": "object",
      "required": ["voltage", "kw", "plug_type", "electrician_required", "notes"],
      "properties": {
        "voltage": { "enum": [120, 230, 400, "wood", "none"] },
        "kw": { "type": ["number", "null"], "minimum": 0 },
        "plug_type": { "type": ["string", "null"] },
        "electrician_required": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sauna": {
      "type": "object",
      "required": ["type", "indoor_outdoor", "heater_type", "max_temp_c", "heat_up_time_min", "wood_type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "indoor_outdoor": { "enum": ["indoor", "outdoor"] },
        "heater_type": { "type": "string", "minLength": 1 },
        "max_temp_c": { "type": ["number", "null"], "minimum": 0 },
        "heat_up_time_min": { "type": ["number", "null"], "minimum": 0 },
        "wood_type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "commercial": {
      "type": "object",
      "required": ["currency", "price_status", "offers"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "price_status": { "enum": ["from", "current", "unavailable"] },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["merchant", "price", "availability", "url", "affiliate", "last_checked"],
            "properties": {
              "merchant": { "type": "string", "minLength": 1 },
              "price": { "type": "number", "minimum": 0 },
              "availability": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "affiliate": { "type": "boolean" },
              "last_checked": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "editorial": {
      "type": "object",
      "required": ["pros", "cons", "ideal_for", "not_for", "test_status", "editorial_score", "disclosure"],
      "properties": {
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "ideal_for": { "type": "array", "items": { "type": "string" } },
        "not_for": { "type": "array", "items": { "type": "string" } },
        "test_status": { "enum": ["not_tested", "hands_on", "lab_tested"] },
        "editorial_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "disclosure": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "title", "url", "checked_at"],
        "properties": {
          "type": { "enum": ["manufacturer", "manual", "merchant", "test"] },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "checked_at": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    },
    "updated_at": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
