{
  "name": "heimsauna-klar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:check && next build --webpack && npm run us:seo:check && npm run us:output:gate && npm run links:check && npm run seo:check && npm run diversity:check && npm run security:check && npm run discovery:check",
    "build:cloudflare": "npm run build",
    "cloudflare:upload": "npx --yes wrangler@4.129.0 deploy",
    "cloudflare:dry-run": "npx --yes wrangler@4.129.0 deploy --dry-run",
    "deploy:cloudflare": "npm run build:cloudflare && npm run cloudflare:upload",
    "start": "next start",
    "lint": "eslint app scripts --ignore-pattern .next --ignore-pattern out",
    "data:check": "node scripts/check-product-schema.mjs && node scripts/validate-data.mjs && node scripts/audit-editorial-expansion.mjs && npm run us:data:check",
    "us:data:check": "node scripts/us/validate-us-data.mjs && node scripts/us/check-launch-snapshot.mjs && npm run us:indexing:plan:check && node --test scripts/us/data-flow-inventory.test.mjs",
    "us:de-baseline:check": "node scripts/us/check-de-baseline.mjs",
    "us:import:review": "node scripts/us/manual-import.mjs",
    "us:offers:promote": "node scripts/us/offer-snapshot.mjs",
    "us:activate:sweat-kingdom": "node scripts/us/activate-sweat-kingdom.mjs",
    "us:expand:sweat-kingdom": "node scripts/us/expand-sweat-kingdom.mjs",
    "us:candidates:sweat-kingdom": "node scripts/us/add-sweat-kingdom-candidates.mjs",
    "us:refresh:release": "node scripts/us/refresh-us-release-snapshot.mjs",
    "us:catalog:review": "node scripts/us/review-catalog.mjs",
    "us:candidates:readiness": "node scripts/us/audit-candidate-publication-readiness.mjs",
    "us:sol:gate": "node scripts/us/check-sol-acceptance-gate.mjs",
    "us:indexing:plan:check": "node scripts/us/check-indexing-readiness.mjs",
    "us:preview:test": "node scripts/us/run-protected-pilot-preview.mjs",
    "us:matrix:check": "node scripts/us/check-test-matrix.mjs",
    "us:snapshot:check": "node scripts/us/check-launch-snapshot.mjs",
    "us:output:gate": "node scripts/us/enforce-publication-output.mjs",
    "us:seo:check": "node scripts/us/check-seo-output.mjs",
    "us:test": "node --test scripts/us/*.test.mjs",
    "us:ci": "npm run us:matrix:check && npm run us:indexing:plan:check && npm run us:test && npm run us:de-baseline:check && npm run us:preview:test",
    "links:check": "node scripts/check-internal-links.mjs",
    "seo:check": "node scripts/check-static-seo.mjs",
    "diversity:check": "node scripts/check-content-diversity.mjs",
    "security:check": "node scripts/check-security-headers.mjs",
    "discovery:check": "node scripts/check-discovery-files.mjs",
    "indexing:generate": "node scripts/generate-product-indexing.mjs",
    "awin:discover": "node scripts/awin/discover-feeds.mjs",
    "awin:candidates": "node scripts/awin/audit-catalog-candidates.mjs",
    "awin:promote": "node scripts/promote-awin-expansion.mjs",
    "awin:review:demmelhuber-karibu": "node scripts/review-demmelhuber-karibu-catalog.mjs",
    "awin:promote:demmelhuber-karibu": "node scripts/promote-demmelhuber-karibu-expansion.mjs",
    "awin:sync": "node scripts/awin/sync-affiliate-offers.mjs",
    "awin:test": "node --test scripts/awin/*.test.mjs",
    "offer:test": "node --test --experimental-strip-types scripts/offer-policy.test.ts",
    "test": "npm run offer:test && npm run us:test && npm run data:check && npm run build"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
