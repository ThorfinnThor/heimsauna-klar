{
  "name": "heimsauna-klar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:check && next build && npm run links:check && npm run seo:check",
    "build:cloudflare": "npm run build",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
    "start": "next start",
    "lint": "eslint app scripts --ignore-pattern .next --ignore-pattern out",
    "data:check": "node scripts/validate-data.mjs",
    "links:check": "node scripts/check-internal-links.mjs",
    "seo:check": "node scripts/check-static-seo.mjs",
    "test": "npm run data:check && npm run build"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
